{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --rebase --autostash -q 2>/dev/null; echo \"[team] main: $(git log -1 --format='%h %s (%an, %ar)' 2>/dev/null)\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/team-sync.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
