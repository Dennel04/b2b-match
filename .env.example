# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only (src/actions, scripts). Never in a component.
SUPABASE_SERVICE_ROLE_KEY=

# Model provider. Option A — Anthropic: an API key from console.anthropic.com → API Keys
# (sk-ant-api…). A Claude-subscription OAuth token (sk-ant-oat…) does NOT work here.
ANTHROPIC_API_KEY=
# Tavily (tavily.com, free tier): the fallback reader, used only when our own fetch of a company
# website comes back empty — a site rendered in the browser, or one whose bot protection refuses
# our server. Without it those sites simply cannot be read.
# THIS ONE ALSO HAS TO BE SET IN VERCEL → Settings → Environment Variables, or the deployed site
# silently has no fallback while local development does.
TAVILY_API_KEY=
# Option B — DeepSeek through its Anthropic-compatible endpoint: put the DeepSeek key in
# ANTHROPIC_API_KEY above and uncomment the two lines below. Claude model names are mapped
# automatically (opus → deepseek-v4-pro); MODEL_ID pins it explicitly.
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-v4-pro

# id of any registered user (Supabase → Authentication → Users), needed by npm run seed
SEED_OWNER_ID=

# Stripe (test mode): the vendor pays an introduction fee when a meeting is accepted.
# Server only — never expose the secret key to the browser. Vercel needs these too, or
# /api/checkout answers 503. See STRIPE_INTEGRATION_TODO.md.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Optional: the deployed host, for success_url and cancel_url. Falls back to the request origin.
DOMAIN=
