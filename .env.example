# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секрет! Только сервер (src/actions, scripts). Никогда в компоненты.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# id любого зарегистрированного юзера (Supabase → Authentication → Users), нужен для npm run seed
SEED_OWNER_ID=
